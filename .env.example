OPENAI_API_KEY=sk-xxx
GROQ_API_KEY=gsk_xxx
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
YOLO_MODEL=yolov8n.pt
YOLO_CONF_THRESHOLD=0.4
# 시연 지연 최적화. 느린 장비면 YOLO_IMGSZ를 320, 정확도가 부족하면 512로 조정.
YOLO_IMGSZ=416
DETECT_INTERVAL_SEC=0.12
DETECTION_BROADCAST_INTERVAL=0.08
AI_LOOP_SLEEP_SEC=0.01
DANGER_DISTANCE_CM=30
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEMO_MODE=false
# 시연 운영자 토글 녹음 모드: 대시보드 버튼/Space로 녹음 시작·종료(VAD 루프 비활성)
MANUAL_RECORDING_MODE=false
MANUAL_RECORDING_MAX_SEC=15
# 골전도 이어폰 버튼 로그 진단. true면 RAW/heartbeat 로그가 많이 출력됨.
BT_BUTTON_DEBUG=false
BT_BUTTON_STARTUP_GRACE_SEC=0.8
VAD_SILENCE_THRESHOLD=100
VAD_SILENCE_DURATION=1.8
VAD_MAX_DURATION=10
VAD_LOW_VOLUME_RMS=0
# 적응형 무음 임계(ambient calibration) 킬스위치. on(기본)=배경소음 기반 자동 보정,
# off=VAD_SILENCE_THRESHOLD 고정값만 사용(기존 동작).
VAD_ADAPTIVE=on
# 동적 무음 임계 계수: max(VAD_SILENCE_THRESHOLD, ambient_rms * VAD_AMBIENT_FACTOR).
# 1.5~2.0 권장. 부스가 시끄러울수록 무음 기준이 배경보다 위로 올라가 발화 끝 감지 개선.
VAD_AMBIENT_FACTOR=2.0
VOICE_OUTPUT_SETTLE_SEC=0.4
VOICE_REPROMPT_COOLDOWN_SEC=2.0
# STT 엔진: whisper(로컬·오프라인·고정확) | google(무료·네트워크).
# whisper 선택 시 faster-whisper 미설치/로드 실패면 자동 google 폴백.
#   pip install faster-whisper  (최초 1회 모델 다운로드 → 오프라인 시연 전 미리 받아둘 것)
STT_ENGINE=whisper
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
# 내장 Silero VAD(비음성 억제). onnxruntime 필요할 수 있어 기본 off.
WHISPER_VAD_FILTER=off
# 환각 필터(무음/잡음에 헛텍스트 생성 방지)
WHISPER_NO_SPEECH_THRESHOLD=0.6
WHISPER_LOGPROB_THRESHOLD=-1.0
